{
  "name": "lightstair-css",
  "version": "0.6.1",
  "description": "CLI tool that generates CSS files with lightness steps for text, background, and border colors based on the OKLCH color space. / OKLCH 색상 공간을 기반으로 글자·배경·테두리 색의 밝기 단계를 설정하여 CSS 파일을 생성하는 CLI 도구.",
  "keywords": [
    "color",
    "css",
    "cli",
    "theming",
    "dark-mode",
    "lightstair"
  ],
  "author": "박민권 <ani2life@gmail.com> (https://github.com/ani2life)",
  "license": "MIT",
  "homepage": "https://github.com/ani2life/lightstair-css",
  "repository": {
    "type": "git",
    "url": "https://github.com/ani2life/lightstair-css"
  },
  "bugs": {
    "url": "https://github.com/ani2life/lightstair-css/issues"
  },
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "lightstair-css": "./bin/cli.js"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm run build:types"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@toolsnap/css-minifier-tool": "^1.0.0",
    "chokidar": "^6.0.0",
    "colorjs.io": "^0.6.1",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "yaml": "^2.9.0"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "preview/",
    "types/"
  ]
}
